DATABASE_URL="postgresql://agent@localhost:5432/floxi.si?host=/workspace/.postgres/socket"
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Change to true behind HTTPS in production.
COOKIE_SECURE=false
# Exact additional origins allowed for administrator-configured model endpoints.
# Local inference example: http://localhost:8000
MODEL_ALLOWED_ORIGINS=
# Set FLOXI_MODEL_KEY_<NAME> on the server, then reference its name in Models.
# Never commit actual provider keys.
