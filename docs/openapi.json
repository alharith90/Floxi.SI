  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "floxi_session"
      }
    },
    "schemas": {
      "EndpointCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "baseUrl": {
            "type": "string",
            "maxLength": 500,
            "format": "uri"
          },
          "apiStyle": {
            "default": "chat-completions",
            "type": "string",
            "enum": [
              "chat-completions",
              "responses"
            ]
          },
          "chatModel": {
            "default": null,
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "embeddingModel": {
            "default": null,
            "nullable": true,
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dimensions": {
            "default": null,
            "nullable": true,
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "credentialEnv": {
            "default": null,
            "nullable": true,
            "type": "string",
            "pattern": "^FLOXI_MODEL_KEY_[A-Z0-9_]+$"
          }
        },
        "required": [
          "name",
          "baseUrl",
          "apiStyle",
          "chatModel",
          "embeddingModel",
          "dimensions",
          "credentialEnv"
        ],
        "additionalProperties": false
      },
      "CompletionRequest": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "system": {
            "default": "",
            "type": "string",
            "maxLength": 8000
          },
          "temperature": {
            "default": 0.7,
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "default": 512,
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "required": [
          "prompt",
          "system",
          "temperature",
          "maxTokens"
        ],
        "additionalProperties": false
      },
      "SetupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
